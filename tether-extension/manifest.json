{
  "manifest_version": 3,
  "name": "Tether",
  "version": "1.1.1",
  "description": "Sync allowlisted websites to Tether when you start working",
  "permissions": ["tabs", "storage", "windows", "alarms"],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://*.supabase.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tether"
  }
}
